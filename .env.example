# Copy to .env, fill in OPENAI_API_KEY, and run `python -m scripts.setup`.
# Never commit .env (it is gitignored).
#
# Only OPENAI_API_KEY is required. Everything below it has a working default
# that targets the local Docker stack.

# --------------------------------------------------------------------------- #
# Models. Required.
# --------------------------------------------------------------------------- #
# Any OpenAI-compatible endpoint works. Point OPENAI_BASE_URL at your own
# deployment (Azure AI Foundry, a local server, a gateway) and match the model
# names to what it serves. Documents are sent to whatever you configure here,
# so if your documents cannot leave your network, host the endpoint yourself.
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5.4-mini
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_REASONING_MODEL=gpt-5.4
OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_BASE_URL=
# Embeddings may live behind a different endpoint and key than chat.
# OPENAI_EMBED_BASE_URL=
# OPENAI_EMBED_API_KEY=
# OPENAI_NORMALISE_MODEL=
# OPENAI_NORMALISE_HEAVY_MODEL=gpt-5.4

# --------------------------------------------------------------------------- #
# Which domain this instance serves
# --------------------------------------------------------------------------- #
# One deployment, one document domain, resolved once at import. Set this, or
# put `domain: <name>` in configs/pipeline.yaml, or ship exactly one pack under
# configs/packs/ and it is detected. With two packs and no declaration the app
# refuses to start rather than guess, because guessing means extracting every
# document against the wrong schema.
# VERBATIM_DOMAIN=commercial_agreement

# --------------------------------------------------------------------------- #
# What this instance calls itself
# --------------------------------------------------------------------------- #
# Served to the browser by GET /branding, so a rename is a restart.
# APP_NAME=Verbatim
# APP_TAGLINE=Every answer traced to the clause it came from
# What the interface calls the things this instance holds. Every screen reads
# these, so a deployment over medical records or planning applications does not
# have to say "contract".
# APP_DOCUMENT_NOUN=document
# APP_DOCUMENT_NOUN_PLURAL=documents

# The first admin account, created on first boot when there are no accounts.
# Sign-in is passwordless, so this address is the key to the instance.
# BOOTSTRAP_ADMIN_EMAIL=admin@localhost
# BOOTSTRAP_ADMIN_NAME=Administrator

# --------------------------------------------------------------------------- #
# Knowledge store (Azure Cosmos DB, NoSQL API)
# --------------------------------------------------------------------------- #
# The defaults target the emulator that `docker compose up -d cosmos` starts,
# including its published dev key. On real Azure, set URI and KEY and switch
# the vector mode to native so search uses the DiskANN index.
# COSMOS_URI=http://localhost:8081
# COSMOS_KEY=
# COSMOS_DB=verbatim
# COSMOS_CONTAINER=kb
# COSMOS_VECTOR_MODE=client

# --------------------------------------------------------------------------- #
# Document reader: how a PDF becomes text with page geometry
# --------------------------------------------------------------------------- #
# rapidocr (default): local OCR plus a model pass that corrects it. Free apart
#   from the correction calls, and needs no cloud service.
# cu: Azure Content Understanding. One paid call per document, cached.
# READER=rapidocr
# CU_ENDPOINT=https://<resource>.cognitiveservices.azure.com
# CU_KEY=
# CU_ANALYZER=prebuilt-layout

# --------------------------------------------------------------------------- #
# Durable file store
# --------------------------------------------------------------------------- #
# A local folder by default. Set the Blob variables when the container has no
# persistent disk, so uploads survive a redeploy.
STORAGE_ROOT=./storage
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_ACCOUNT_URL=
# AZURE_BLOB_CONTAINER=storage

# --------------------------------------------------------------------------- #
# Review thresholds
# --------------------------------------------------------------------------- #
# How many verifiers must agree before a value counts as human verified, and
# how many a CORRECTED value needs. A correction overrides the machine
# everywhere, so it asks for a second pair of eyes by default.
#
# On a single-operator instance set the correction bar to 1. Otherwise nobody
# there can ever finish a correction, because the second verifier does not
# exist.
# REVIEW_MIN_APPROVALS=1
# REVIEW_CORRECTION_APPROVALS=2

# --------------------------------------------------------------------------- #
# API options, all optional
# --------------------------------------------------------------------------- #
# CHAT_API_KEY requires the same value in an X-API-Key header on every route.
# It keeps an internal deployment off the open internet. It is not per-user
# authentication and does not replace it. See SECURITY.md.
# CHAT_API_KEY=
# CHAT_CORS_ORIGINS=
# CHAT_DISABLED_TOOLS=
# LOG_FORMAT=json

# --------------------------------------------------------------------------- #
# Tuning
# --------------------------------------------------------------------------- #
VISION_PAGE_CONCURRENCY=4
RENDER_DPI=300
